{
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonl]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "angular.forceStrictTemplates": true,
  "chat.experimental.useSkillAdherencePrompt": true,
  "chat.includeReferencedInstructions": true,
  "chat.mcp.assisted.nuget.enabled": true,
  "chat.mcp.gallery.enabled": true,
  "chat.sessionSync.enabled": true,
  "chat.tools.compressOutput.enabled": true,
  "chat.tools.confirmationCarousel.enabled": true,
  "chat.useNestedAgentsMdFiles": true,
  "css.format.spaceAroundSelectorSeparator": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.fixAll": "explicit",
    "source.fixAll.oxc": "explicit",
    "source.fixAllDangerous.oxc": "explicit",
    "source.format.oxc": "explicit",
    "source.organizeImports": "explicit",
    "source.removeUnusedImports": "explicit",
    "source.sort": "explicit",
    "source.sort.json": "explicit",
    "source.sortImports": "explicit"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.tabSize": 2,
  "editor.wordWrapColumn": 100,
  "editorconfig.generateAuto": false,
  "evenBetterToml.formatter.alignComments": true,
  "evenBetterToml.formatter.alignEntries": true,
  "evenBetterToml.formatter.allowedBlankLines": 1,
  "evenBetterToml.formatter.arrayAutoExpand": true,
  "evenBetterToml.formatter.arrayTrailingComma": true,
  "evenBetterToml.formatter.columnWidth": 100,
  "evenBetterToml.formatter.inlineTableExpand": true,
  "evenBetterToml.formatter.reorderArrays": true,
  "evenBetterToml.formatter.reorderInlineTables": true,
  "evenBetterToml.formatter.reorderKeys": true,
  "evenBetterToml.formatter.trailingNewline": true,
  "evenBetterToml.schema.links": true,
  "evenBetterToml.semanticTokens": true,
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.alwaysSignOff": true,
  "git.enableCommitSigning": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.includeDocumentation": true,
  "github.copilot.chat.languageContext.typescript7.enabled": true,
  "github.copilot.chat.switchAgent.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.gitProtocol": "ssh",
  "html.format.indentHandlebars": true,
  "html.format.indentInnerHtml": true,
  "html.format.templating": true,
  "html.format.wrapLineLength": 100,
  "js/ts.format.semicolons": "insert",
  "js/ts.implicitProjectConfig.target": "ESNext",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.suggest.paths": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "jsts-chat-features.skills.enabled": true,
  "less.format.spaceAroundSelectorSeparator": true,
  "markdown.validate.enabled": true,
  "npm-intellisense.packageSubfoldersIntellisense": true,
  "npm.packageManager": "bun",
  "npm.scriptRunner": "bun",
  "nxConsole.nxCloudNotifications": "none",
  "nxConsole.nxWorkspacePath": ".",
  "oxc.configPath": "oxlint.config.mts",
  "oxc.enable": true,
  "oxc.enable.oxfmt": true,
  "oxc.enable.oxlint": true,
  "oxc.fixKind": "all",
  "oxc.fmt.configPath": "oxfmt.config.mts",
  "oxc.tsConfigPath": "tsconfig.base.json",
  "oxc.typeAware": true,
  "scss.format.spaceAroundSelectorSeparator": true,
  "tailwindCSS.emmetCompletions": true,
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "terminal.integrated.suggest.enabled": true,
  "workbench.browser.experimentalUserTools.enabled": true,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false
}
