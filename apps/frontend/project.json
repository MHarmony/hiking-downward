{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "i18n": {
    "locales": {
      "es": {
        "subPath": "es",
        "translation": "apps/frontend/src/locale/messages.es.xlf"
      }
    },
    "sourceLocale": {
      "code": "en-US",
      "subPath": "en"
    }
  },
  "name": "@hiking-downward/frontend",
  "prefix": "hiking-downward",
  "projectType": "application",
  "sourceRoot": "apps/frontend/src",
  "tags": [
    "scope:frontend"
  ],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "extractLicenses": false,
          "localize": [
            "en-US"
          ],
          "optimization": false,
          "sourceMap": true
        },
        "development-es": {
          "extractLicenses": false,
          "localize": [
            "es"
          ],
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "define": {
            "__SENTRY_DEBUG__": "false",
            "__SENTRY_TRACING__": "false"
          },
          "budgets": [
            {
              "maximumError": "1mb",
              "maximumWarning": "500kb",
              "type": "initial"
            },
            {
              "maximumError": "8kb",
              "maximumWarning": "4kb",
              "type": "anyComponentStyle"
            }
          ],
          "localize": true,
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@angular/build:application",
      "options": {
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/frontend/public"
          }
        ],
        "browser": "apps/frontend/src/main.ts",
        "i18nMissingTranslation": "error",
        "outputPath": "dist/apps/frontend",
        "polyfills": [
          "@angular/localize/init"
        ],
        "styles": [
          "apps/frontend/src/styles.css"
        ],
        "tsConfig": "apps/frontend/tsconfig.app.json"
      },
      "outputs": [
        "{options.outputPath}"
      ]
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "@hiking-downward/frontend:build",
        "format": "xlf2",
        "outFile": "messages.xlf",
        "outputPath": "apps/frontend/src/locale"
      }
    },
    "serve": {
      "configurations": {
        "development": {
          "buildTarget": "@hiking-downward/frontend:build:development"
        },
        "development-es": {
          "buildTarget": "@hiking-downward/frontend:build:development-es"
        },
        "production": {
          "buildTarget": "@hiking-downward/frontend:build:production"
        }
      },
      "continuous": true,
      "defaultConfiguration": "development",
      "dependsOn": [
        {
          "projects": [
            "@hiking-downward/api"
          ],
          "target": "serve"
        }
      ],
      "executor": "@angular/build:dev-server"
    },
    "serve-static": {
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/frontend-e2e/serve-localized-static.mjs",
        "cwd": "."
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "coverage": true,
        "coverageThresholds": {
          "branches": 100,
          "functions": 100,
          "lines": 100,
          "statements": 100
        },
        "watch": false
      }
    },
    "typecheck": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "command": "tsc --noEmit -p apps/frontend/tsconfig.app.json"
      }
    },
    "typecheck:test": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "command": "tsc --noEmit -p apps/frontend/tsconfig.spec.json"
      }
    }
  }
}
