{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "@hiking-downward/api"
  ],
  "name": "@hiking-downward/api-e2e",
  "projectType": "application",
  "sourceRoot": "apps/api-e2e/src",
  "tags": [
    "scope:api"
  ],
  "targets": {
    "e2e": {
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "@hiking-downward/api"
          ],
          "target": "serve:e2e"
        }
      ],
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "^{projectRoot}/tsconfig*.json",
        {
          "externalDependencies": [
            "@playwright/test"
          ]
        }
      ],
      "options": {
        "command": "playwright test",
        "cwd": "apps/api-e2e"
      },
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/api-e2e/test-output",
        "{workspaceRoot}/dist/.playwright/apps/api-e2e/playwright-report"
      ]
    },
    "typecheck:test": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "command": "bun check -p apps/api-e2e/tsconfig.json"
      }
    }
  }
}
