  "scripts": {
    "build": "nx run-many -t build",
    "db:generate": "drizzle-kit generate --config libs/api/database/drizzle.config.mts",
    "db:migrate": "drizzle-kit migrate --config libs/api/database/drizzle.config.mts",
    "e2e": "nx run-many -t e2e",
    "lint": "nx run-many -t lint",
    "postinstall": "lefthook install",
    "skills:update": "bunx skills update -y",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck typecheck:test"
